# =========================================================
# Configuration du portfolio — copier vers « .env »
#
#     cp .env.example .env
#
# Ce fichier n'est JAMAIS versionné (.gitignore) : c'est ici, et
# seulement ici, que vivent les secrets (clé Django, mot de passe du
# compte admin, mot de passe d'application Gmail).
# =========================================================

# --- Port d'exposition du site public -------------------
PORT=8080

# --- Compte du back-office ------------------------------
# Recommandé : identifiant + mot de passe forts, jamais
# identiques à ceux du dépôt. Laisser ADMIN_PASSWORD vide
# empêche la création du compte (aucun accès par défaut).
ADMIN_USERNAME=angelo
ADMIN_PASSWORD=

# --- Django ---------------------------------------------
DJANGO_DEBUG=0
# Clé secrète de Django — OBLIGATOIRE en production.
# Elle signe les sessions et les jetons CSRF : sans elle (ou avec la
# valeur par défaut du dépôt), Django refuse de démarrer.
# Générer la vôtre :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key(50))"
DJANGO_SECRET_KEY=
# Adresses autorisées, séparées par des virgules.
# Exemple de production : mondomaine.mg,www.mondomaine.mg
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Indian/Antananarivo
# Une fois le domaine en place (obligatoire derrière HTTPS) :
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ton-domaine.com

# --- Cookies / HTTPS -----------------------------------
# Activer UNIQUEMENT derrière HTTPS (voir README « Sécurité ») :
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
# 0 en HTTP local ; 31536000 une fois HTTPS installé :
SECURE_HSTS_SECONDS=0

# --- Sécurité de la connexion back-office ---------------
# Blocage après N tentatives échouées, pendant M minutes (par IP) :
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
# Déconnexion automatique de l'admin après inactivité (secondes) :
ADMIN_IDLE_SECONDS=1800

# --- GitHub ---------------------------------------------
GITHUB_USERNAME=angelorandrianasolo
GITHUB_CACHE_SECONDS=900

# --- Téléversements (octets) ----------------------------
# 20 Mo par défaut.
MAX_UPLOAD_SIZE=20971520

# --- Formulaire de contact (envoi d'email) --------------
#
# Par défaut : backend « console ». L'email est écrit dans les logs
# du conteneur (`docker compose logs api`) au lieu d'être envoyé.
# Aucun compte requis pour développer.
#
# Pour recevoir les messages dans votre boîte mail (Gmail) :
#   1. Activez la vérification en 2 étapes sur le compte Google
#   2. Générez un « mot de passe d'application » :
#      https://myaccount.google.com/apppasswords
#   3. Débloquez SMTP ci-dessous puis relancez :
#        docker compose up -d
#   (Configuration validée sur ce poste : port 465 + SSL — le
#    port 587/STARTTLS est intercepté par Avast Web/Mail Shield.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT=angelorandrianasolo47@gmail.com
# Plafond anti-spam : messages max par IP et par heure :
CONTACT_MAX_PER_HOUR=5
